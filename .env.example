# ==============================================================================
# AgentOps Environment Configuration Template
#
# NOTE: All defaults are secure and configured for local loopback development.
# Paid API keys are completely OPTIONAL. By default, MOCK providers are used.
# NEVER commit your actual `.env` file to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & API Runtime
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME=AgentOps
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
# Secret key used for JWT / token signing (minimum 32 characters)
SECRET_KEY=dev-secret-key-change-in-production-at-least-32-chars-long
# Internal service API key required for client API requests and n8n webhooks
API_KEY=agentops-dev-internal-key

# ------------------------------------------------------------------------------
# 2. PostgreSQL Multi-Database Configuration
# ------------------------------------------------------------------------------
# Administrative Superuser (Used by init-databases.sh on initial volume boot)
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=postgres_dev_pass
POSTGRES_DB=postgres

# AgentOps Application Role & Database (Least Privilege)
AGENTOPS_DB_USER=agentops_user
AGENTOPS_DB_PASSWORD=agentops_pass
AGENTOPS_DB_NAME=agentops_db

# Connection strings used by the backend application
# Inside Docker Compose: host is 'postgres'
# Host direct development (with compose.override.yaml): host is '127.0.0.1'
DATABASE_URL=postgresql+asyncpg://agentops_user:agentops_pass@postgres:5432/agentops_db
SYNC_DATABASE_URL=postgresql://agentops_user:agentops_pass@postgres:5432/agentops_db

# ------------------------------------------------------------------------------
# 3. Redis & Celery Task Queue
# ------------------------------------------------------------------------------
# Inside Docker Compose: host is 'redis'
# Host direct development (with compose.override.yaml): host is '127.0.0.1'
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# 4. n8n Community Automation Service
# ------------------------------------------------------------------------------
# Dedicated role and database for n8n Community
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=n8n_pass
N8N_DB_NAME=n8n_db

# CRITICAL: Encryption key for n8n credentials storage.
# Must remain stable across restarts/migrations. Generate a random 32-byte hex key:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# n8n Webhook Integration
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/agentops-notifications
N8N_WEBHOOK_SECRET=n8n_local_webhook_secret_for_hmac_verification

# ------------------------------------------------------------------------------
# 5. AI Models & Search Providers (Default: Mock / Zero-Cost)
# ------------------------------------------------------------------------------
# Options for LLM_PROVIDER: mock (default), openai, ollama
LLM_PROVIDER=mock
# Options for SEARCH_PROVIDER: mock (default), tavily, duckduckgo
SEARCH_PROVIDER=mock
MOCK_DETERMINISTIC_SEED=42

# Optional External API Keys & Endpoints (NOT required for local mock operation)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_NAME=llama3.2
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# 6. Safety Limits & Execution Budgets
# ------------------------------------------------------------------------------
MAX_PLAN_STEPS=10
MAX_EXECUTION_SECONDS=300
STEP_TIMEOUT_SECONDS=60
MAX_RETRIES_PER_STEP=2
BUDGET_USD_LIMIT=1.00

# ------------------------------------------------------------------------------
# 7. Observability & Tracing
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
