# ==============================================================================
# AgentOps Environment Configuration Template
# NOTE: All defaults are secure and configured for local loopback development.
# Paid API keys are completely OPTIONAL. By default, MOCK providers are used.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=AgentOps
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
SECRET_KEY=change-me-in-production-use-a-strong-secret-key-at-least-32-chars

# Database Configuration (PostgreSQL)
# Loopback access only. Never expose to public interfaces.
DATABASE_URL=postgresql+asyncpg://agentops_user:agentops_pass@127.0.0.1:5432/agentops_db
SYNC_DATABASE_URL=postgresql://agentops_user:agentops_pass@127.0.0.1:5432/agentops_db

# Redis & Celery Background Workers
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# AI & Search Adapters
# Options for LLM_PROVIDER: mock (default), openai, ollama
LLM_PROVIDER=mock
# Options for SEARCH_PROVIDER: mock (default), tavily, duckduckgo
SEARCH_PROVIDER=mock
MOCK_DETERMINISTIC_SEED=42

# Optional External API Keys & Endpoints (NOT required for local mock operation)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_NAME=llama3.2
TAVILY_API_KEY=

# Execution Safety Limits & Budgets
MAX_PLAN_STEPS=10
MAX_EXECUTION_SECONDS=300
STEP_TIMEOUT_SECONDS=60
MAX_RETRIES_PER_STEP=2
BUDGET_USD_LIMIT=1.00

# Observability & Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Automation & Notification Integrations (n8n Community)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
